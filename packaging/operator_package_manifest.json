{
  "schema_version": "1.0",
  "package_name": "customsops-controlled-operator-package",
  "milestone": "v4.2-milestone-7-controlled-pilot-gate",
  "status": "boundary_manifest_only_not_a_release_package",
  "classification_rules": {
    "operator_local_candidate": [
      "agent/customsops_agent/config.py",
      "agent/customsops_agent/main.py",
      "agent/customsops_agent/signed_plan.py",
      "agent/customsops_agent/action_executor.py",
      "agent/customsops_agent/window_foreground.py",
      "agent/customsops_agent/evidence_v311_adapter.py",
      "agent/customsops_agent/machine_identity.py",
      "agent/customsops_agent/operator_flow.py",
      "agent/customsops_agent/operator_cli.py",
      "agent/customsops_agent/evidence_reference.py",
      "agent/customsops_agent/executors/**",
      "shared/signing/ed25519.py",
      "shared/schemas/action.schema.json",
      "shared/schemas/job_plan.schema.json",
      "shared/schemas/machine_registration.schema.json",
      "shared/schemas/evidence_reference.schema.json",
      "shared/schemas/pilot_gate_record.schema.json",
      "scripts/windows_lab_smoke_prepare_env.ps1",
      "scripts/windows_lab_smoke_runner.ps1",
      "scripts/windows_lab_smoke_collect_evidence.ps1",
      "packaging/windows_operator/pilot_gate_record.ps1",
      "packaging/windows_operator/operator_allowlist.example.json",
      "packaging/windows_operator/machine_allowlist.example.json"
    ],
    "server_only": [
      "control_plane/**",
      "control_plane/packs/**",
      "delivery_packs/**"
    ],
    "test_only": [
      "tests/**"
    ],
    "docs_only_internal": [
      "docs/v4.2_controlled_operator_package_plan.md",
      "docs/v4.2_security_boundary.md",
      "docs/v4.2_operator_package_acceptance_criteria.md",
      "docs/v4.2_release_packaging_checklist.md",
      "docs/v4.2_implementation_roadmap.md",
      "docs/v4.2_package_file_classification.md",
      "docs/v4.2_machine_registration.md",
      "docs/v4.2_signed_job_only_operator_flow.md",
      "docs/v4.2_operator_ux_shell.md",
      "docs/v4.2_evidence_reference_model.md",
      "docs/v4.2_controlled_pilot_gate.md",
      "docs/v4.2_operator_package_note_template.md",
      "docs/v4.2_pilot_rollback_disable.md"
    ],
    "excluded": [
      ".git/**",
      ".venv/**",
      "__pycache__/**",
      ".pytest_cache/**",
      ".ruff_cache/**",
      ".bandit/**",
      "outputs/**",
      "lab/**",
      "*.zip",
      "*.xlsx",
      "*.xls",
      "*.xlsm",
      "*.pem",
      "*.key",
      "*.p12",
      "*.pfx",
      "*.env",
      "*.log"
    ]
  },
  "forbidden_in_operator_package": [
    "control_plane/packs",
    "declaration_job_compiler.py",
    "job_compiler.py",
    "safebrake_policy.example.yaml",
    "field_map.example.yaml",
    "country pack content",
    "signing private key",
    "real customer data",
    "broker authorization value",
    "production credentials"
  ],
  "forbidden_actions": [
    "submit",
    "register",
    "payment",
    "tax_finalize"
  ],
  "allowed_modes": [
    "fillOnly",
    "safeBrakeStore"
  ],
  "machine_registration": {
    "local_config_path": "%USERPROFILE%/.customsops/machine_registration.json",
    "status_values": ["pending", "active", "revoked", "disabled"],
    "active_required_for_execution": true,
    "revoked_or_disabled_fail_closed": true
  },
  "operator_flow": {
    "signed_job_only": true,
    "requires_active_machine_registration": true,
    "requires_trusted_public_key": true,
    "local_excel_to_executable_plan_compilation": false
  },
  "operator_ux_shell": {
    "status_command": true,
    "manifest_superficial_precheck": true,
    "run_signed_job_command": true,
    "plan_editor": false,
    "country_pack_viewer": false,
    "local_excel_to_executable_plan_compilation": false
  },
  "evidence_reference_model": {
    "reference_only": true,
    "raw_artifacts_uploaded": false,
    "screenshot_content_included": false,
    "support_diagnostics_content_included": false,
    "requires_hq_review": true
  },
  "controlled_pilot_gate": {
    "gate_record_only": true,
    "requires_operator_allowlist": true,
    "requires_machine_allowlist": true,
    "requires_build_manifest": true,
    "requires_checksum_file": true,
    "external_distribution_approved": false
  },
  "notes": [
    "This manifest is an audit boundary only and does not build an operator package.",
    "The eventual package builder must use a strict allowlist and prove that server_only and excluded patterns are absent from output artifacts.",
    "Machine registration files are local candidates only; production registration authority remains server-side.",
    "Operator flow files are local candidates only; signed-job issuance remains server-side.",
    "Operator UX shell performs local precheck and signed-job invocation only; it does not parse Excel rows into executable steps.",
    "Evidence reference model emits hashes and metadata only; it does not upload or embed raw evidence artifacts.",
    "Controlled pilot gate records review inputs only; it does not approve external distribution.",
    "No source-tree distribution is approved by this manifest."
  ]
}
